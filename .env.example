# Copy to .env and fill in. docker-compose reads this automatically.
#
# VirusTotal API key used by the malware-capture SOAR integration
# (src/soar/malware_capture.py). Get a free key at https://www.virustotal.com.
# Left blank/default, the integration logs the hash but skips the online lookup.
VT_API_KEY=YOUR_API_KEY_HERE

# --- Phase A: AI Threat Analyst (src/soar/threat_report.py) -----------------
# Which LLM backend to use: gemini | ollama | claude
LLM_PROVIDER=gemini

# Egress guardrail: pseudonymise attacker IPs, usernames and file hashes before
# sending to the LLM; real values are restored into the local report. Safe to
# set false only for the fully local/offline ollama backend.
REDACT_PII=true

# -- gemini (free tier) --
# Free Gemini key from https://aistudio.google.com (Google AI Studio).
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
# gemini-2.5-flash has its own daily quota; gemini-2.0-flash's free cap is tiny.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_RPM=10        # sliding-window cap enforced across runs (free tier ~15/min)
GEMINI_MAX_RETRIES=4     # 429/5xx retries with exponential backoff

# -- ollama (local, offline, private; no key; REDACT_PII optional) --
# The analyst runs on the host, so this is localhost (not host.docker.internal).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# -- claude (Anthropic; highest quality; keep REDACT_PII=true) --
# Key from https://console.anthropic.com
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY_HERE
CLAUDE_MODEL=claude-opus-5      # set claude-haiku-4-5 for cheap/fast
CLAUDE_MAX_TOKENS=8192
CLAUDE_MAX_RETRIES=4

# -- groq (free tier, very fast, OpenAI-compatible; keep REDACT_PII=true) --
# Free key from https://console.groq.com
GROQ_API_KEY=YOUR_GROQ_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=8192
GROQ_MAX_RETRIES=4
