# Copy to .env and fill in. docker-compose reads this automatically.
#
# VirusTotal API key used by the malware-capture SOAR integration
# (scripts/malware_capture.py). Get a free key at https://www.virustotal.com.
# Left blank/default, the integration logs the hash but skips the online lookup.
VT_API_KEY=YOUR_API_KEY_HERE

# --- Phase A: AI Threat Analyst (scripts/threat_report.py) ------------------
# Which LLM backend to use. Currently: gemini.
LLM_PROVIDER=gemini
# Free Gemini key from https://aistudio.google.com  (Google AI Studio).
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
# Free-tier model. gemini-2.5-flash has its own daily quota; gemini-2.0-flash
# has a very small free daily request cap that exhausts quickly.
GEMINI_MODEL=gemini-2.5-flash

# Rate-limit guardrails (free tier is ~15 requests/min).
GEMINI_MAX_RPM=10        # sliding-window cap enforced across runs
GEMINI_MAX_RETRIES=4     # 429/5xx retries with exponential backoff

# Egress guardrail: pseudonymise attacker IPs, usernames and file hashes
# before sending to the LLM; real values are restored into the local report.
# Set false only when using a fully local/offline backend.
REDACT_PII=true
