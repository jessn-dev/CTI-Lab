<!--
  Local decoders for the Threat Intelligence Lab.

  Phase C1/C5: parse the honeypot's snoopy command-audit log. Each line looks like:
    snoopy: user=root uid=0 tty=(none) cwd=/ cli=1.2.3.4 55622 22 cmd=cat /etc/shadow
  `command` is classified into sophistication categories (rules 100410+); `srcip`
  (the SSH client IP, empty for local/system execs) lets the tripwire ban drive
  active_defense (Phase C5). cli holds SSH_CLIENT (ip cport sport), so we capture
  just the leading IP and skip the ports up to " cmd=".
-->
<decoder name="snoopy">
  <prematch>^snoopy: </prematch>
</decoder>

<decoder name="snoopy-fields">
  <parent>snoopy</parent>
  <regex type="pcre2">user=(\S+) uid=(\d+) tty=(\S+) cwd=(\S+) cli=(\d+\.\d+\.\d+\.\d+)?[^=]*cmd=(.+)$</regex>
  <order>srcuser, uid, tty, cwd, srcip, command</order>
</decoder>
