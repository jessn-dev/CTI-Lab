<!--
  Local rules for the Threat Intelligence Lab.
  Classify beelzebub honeypot events (forwarded as JSON by beelzebub-agent).
  Wazuh's built-in json decoder flattens the log, so nested fields are matched
  as event.<Field>. Rule IDs use the 100000+ local range.
-->
<group name="beelzebub,honeypot,">

  <!-- Base: any beelzebub event (has an event.Protocol field). Low level. -->
  <rule id="100300" level="3">
    <decoded_as>json</decoded_as>
    <field name="event.Protocol">\.+</field>
    <field name="event.Description">Beelzebub</field>
    <description>Beelzebub honeypot event.</description>
    <options>no_full_log</options>
  </rule>

  <!-- SSH interaction: an attacker ran a command in the LLM shell. -->
  <rule id="100301" level="6">
    <if_sid>100300</if_sid>
    <field name="event.Protocol">^SSH$</field>
    <description>Beelzebub LLM SSH honeypot: command run from $(event.SourceIp).</description>
    <group>beelzebub,attack,ssh,</group>
  </rule>

  <!-- HTTP interaction (when the HTTP service is added). -->
  <rule id="100302" level="5">
    <if_sid>100300</if_sid>
    <field name="event.Protocol">^HTTP$</field>
    <description>Beelzebub HTTP honeypot: request from $(event.SourceIp).</description>
    <group>beelzebub,attack,web,</group>
  </rule>

</group>

<!--
  shelLM honeypot events (forwarded as JSON by the shelLM agent from
  /var/log/shellm.json). shelLM is a depth-focused, consistency-driven LLM SSH
  shell; run.sh writes one JSON line per session. IDs use the 100310+ range,
  distinct from beelzebub's 100300-100302.
-->
<group name="shellm,honeypot,">

  <!-- Base: any shelLM event (has honeypot == "shelLM"). Low level. -->
  <rule id="100310" level="3">
    <decoded_as>json</decoded_as>
    <field name="honeypot">^shelLM$</field>
    <description>shelLM honeypot event.</description>
    <options>no_full_log</options>
  </rule>

  <!-- New SSH session: an attacker landed in the shelLM LLM shell. -->
  <rule id="100311" level="6">
    <if_sid>100310</if_sid>
    <field name="event">^session_start$</field>
    <description>shelLM LLM SSH honeypot: new session from $(srcip).</description>
    <group>shellm,attack,ssh,</group>
  </rule>

</group>

<!--
  Phase C1 — honeypot command classification (snoopy command-audit log).
  Each executed command is decoded (see local_decoder.xml) and sorted into a
  MITRE-ish sophistication category. These category rules are the raw signal the
  Phase C2 correlation rules escalate into attacker tiers. IDs: 100410-100419.
-->
<group name="honeypot,command,">

  <!-- Base: any command executed on the honeypot (decoded from snoopy). Low. -->
  <rule id="100410" level="2">
    <decoded_as>snoopy</decoded_as>
    <description>Honeypot: command executed - $(command)</description>
    <options>no_full_log</options>
  </rule>

  <!-- Phase C4 TRIPWIRE: a command references a planted lure (see engage.py).
       Checked before the generic category rules so it wins on a lure hit. This
       is the loudest signal in the lab - the attacker took the bait. -->
  <rule id="100402" level="13">
    <if_sid>100410</if_sid>
    <field name="command" type="pcre2">(?i)(/root/\.ssh/id_rsa|/root/backup_db\.sql|/root/credentials\.txt)</field>
    <description>TRIPWIRE: attacker accessed a planted lure - $(command)</description>
    <group>engagement,tripwire,attack,credential_access,</group>
  </rule>

  <!-- Recon / discovery: enumerating the host, users, network. -->
  <rule id="100411" level="5">
    <if_sid>100410</if_sid>
    <field name="command" type="pcre2">(?i)\b(whoami|id|uname|hostname|netstat|ss|ifconfig|ip\s+a|ps\s|lscpu|cat\s+/etc/(passwd|issue|os-release))\b</field>
    <description>Honeypot recon/discovery: $(command)</description>
    <group>attack,recon,discovery,</group>
  </rule>

  <!-- Credential access: reading secrets. -->
  <rule id="100412" level="7">
    <if_sid>100410</if_sid>
    <field name="command" type="pcre2">(?i)(cat|less|more|head|tail)\s+.*(shadow|id_rsa|\.ssh|credentials|\.aws|\.env|backup.*\.sql)</field>
    <description>Honeypot credential access: $(command)</description>
    <group>attack,credential_access,deep_attack,</group>
  </rule>

  <!-- Ingress tool transfer: pulling payloads onto the box. -->
  <rule id="100413" level="7">
    <if_sid>100410</if_sid>
    <field name="command" type="pcre2">(?i)\b(wget|curl|scp|tftp|nc|ncat|socat)\b</field>
    <description>Honeypot ingress/tool transfer: $(command)</description>
    <group>attack,command_control,deep_attack,</group>
  </rule>

  <!-- Persistence: backdoor accounts, cron, keys, services. -->
  <rule id="100414" level="8">
    <if_sid>100410</if_sid>
    <field name="command" type="pcre2">(?i)(useradd|adduser|usermod|chpasswd|crontab|authorized_keys|systemctl\s+enable|update-rc\.d)</field>
    <description>Honeypot persistence attempt: $(command)</description>
    <group>attack,persistence,deep_attack,</group>
  </rule>

  <!-- Defense evasion: wiping logs / history. -->
  <rule id="100415" level="8">
    <if_sid>100410</if_sid>
    <field name="command" type="pcre2">(?i)(history\s+-c|shred|rm\s+-rf\s+/var/log|:\s*>\s*/var/log|&gt;\s*/var/log/auth\.log|unset\s+HISTFILE)</field>
    <description>Honeypot defense evasion (log/history wipe): $(command)</description>
    <group>attack,defense_evasion,deep_attack,</group>
  </rule>

</group>

<!--
  Phase C2 — attacker sophistication tiers (native Wazuh correlation).
  Fold the per-command category hits into tiers by frequency within a window.
  Command events carry no srcip (snoopy is exec-level), so we can't correlate on
  <same_source_ip/>. Instead we key on honeypot-specific groups: recon (100411)
  and "deep_attack" (100412-100415, tagged), which the LLM honeypots do NOT emit,
  so no cross-honeypot bleed and no <same_location/> needed (it behaved
  inconsistently live). Tier rules use their own "engagement" group so they never
  count themselves. IDs: 100400-100409.
-->
<group name="engagement,">

  <!-- OPPORTUNIST: repeated host/network recon (enumeration), nothing deeper. -->
  <rule id="100400" level="8" frequency="3" timeframe="120">
    <if_matched_sid>100411</if_matched_sid>
    <description>Attacker tier OPPORTUNIST: repeated recon on the honeypot.</description>
    <group>engagement,tier_opportunist,</group>
  </rule>

  <!-- SKILLED: 2+ beyond-recon actions (cred access / ingress / persistence /
       evasion) within the window. This is the ENGAGE trigger: Active Response
       plants lures + holds the ban (see Phase C3). -->
  <rule id="100401" level="12" frequency="2" timeframe="120">
    <if_matched_group>deep_attack</if_matched_group>
    <description>Attacker tier SKILLED: multiple beyond-recon actions - engage.</description>
    <group>engagement,tier_skilled,</group>
  </rule>

</group>
