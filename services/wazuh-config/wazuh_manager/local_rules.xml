<!--
  Local rules for the Threat Intelligence Lab.
  Classify beelzebub honeypot events (forwarded as JSON by beelzebub-agent).
  Wazuh's built-in json decoder flattens the log, so nested fields are matched
  as event.<Field>. Rule IDs use the 100000+ local range.
-->
<group name="beelzebub,honeypot,">

  <!-- Base: any beelzebub event (has an event.Protocol field). Low level. -->
  <rule id="100300" level="3">
    <decoded_as>json</decoded_as>
    <field name="event.Protocol">\.+</field>
    <field name="event.Description">Beelzebub</field>
    <description>Beelzebub honeypot event.</description>
    <options>no_full_log</options>
  </rule>

  <!-- SSH interaction: an attacker ran a command in the LLM shell. -->
  <rule id="100301" level="6">
    <if_sid>100300</if_sid>
    <field name="event.Protocol">^SSH$</field>
    <description>Beelzebub LLM SSH honeypot: command run from $(event.SourceIp).</description>
    <group>beelzebub,attack,ssh,</group>
  </rule>

  <!-- HTTP interaction (when the HTTP service is added). -->
  <rule id="100302" level="5">
    <if_sid>100300</if_sid>
    <field name="event.Protocol">^HTTP$</field>
    <description>Beelzebub HTTP honeypot: request from $(event.SourceIp).</description>
    <group>beelzebub,attack,web,</group>
  </rule>

</group>

<!--
  shelLM honeypot events (forwarded as JSON by the shelLM agent from
  /var/log/shellm.json). shelLM is a depth-focused, consistency-driven LLM SSH
  shell; run.sh writes one JSON line per session. IDs use the 100310+ range,
  distinct from beelzebub's 100300-100302.
-->
<group name="shellm,honeypot,">

  <!-- Base: any shelLM event (has honeypot == "shelLM"). Low level. -->
  <rule id="100310" level="3">
    <decoded_as>json</decoded_as>
    <field name="honeypot">^shelLM$</field>
    <description>shelLM honeypot event.</description>
    <options>no_full_log</options>
  </rule>

  <!-- New SSH session: an attacker landed in the shelLM LLM shell. -->
  <rule id="100311" level="6">
    <if_sid>100310</if_sid>
    <field name="event">^session_start$</field>
    <description>shelLM LLM SSH honeypot: new session from $(srcip).</description>
    <group>shellm,attack,ssh,</group>
  </rule>

</group>
