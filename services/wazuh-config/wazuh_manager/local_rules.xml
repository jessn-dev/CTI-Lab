<!--
  Local rules for the Threat Intelligence Lab.
  Classify beelzebub honeypot events (forwarded as JSON by beelzebub-agent).
  Wazuh's built-in json decoder flattens the log, so nested fields are matched
  as event.<Field>. Rule IDs use the 100000+ local range.
-->
<group name="beelzebub,honeypot,">

  <!-- Base: any beelzebub event (has an event.Protocol field). Low level. -->
  <rule id="100300" level="3">
    <decoded_as>json</decoded_as>
    <field name="event.Protocol">\.+</field>
    <field name="event.Description">Beelzebub</field>
    <description>Beelzebub honeypot event.</description>
    <options>no_full_log</options>
  </rule>

  <!-- SSH interaction: an attacker ran a command in the LLM shell. -->
  <rule id="100301" level="6">
    <if_sid>100300</if_sid>
    <field name="event.Protocol">^SSH$</field>
    <description>Beelzebub LLM SSH honeypot: command run from $(event.SourceIp).</description>
    <group>beelzebub,attack,ssh,</group>
  </rule>

  <!-- HTTP interaction (when the HTTP service is added). -->
  <rule id="100302" level="5">
    <if_sid>100300</if_sid>
    <field name="event.Protocol">^HTTP$</field>
    <description>Beelzebub HTTP honeypot: request from $(event.SourceIp).</description>
    <group>beelzebub,attack,web,</group>
  </rule>

</group>

<!--
  shelLM honeypot events (forwarded as JSON by the shelLM agent from
  /var/log/shellm.json). shelLM is a depth-focused, consistency-driven LLM SSH
  shell; run.sh writes one JSON line per session. IDs use the 100310+ range,
  distinct from beelzebub's 100300-100302.
-->
<group name="shellm,honeypot,">

  <!-- Base: any shelLM event (has honeypot == "shelLM"). Low level. -->
  <rule id="100310" level="3">
    <decoded_as>json</decoded_as>
    <field name="honeypot">^shelLM$</field>
    <description>shelLM honeypot event.</description>
    <options>no_full_log</options>
  </rule>

  <!-- New SSH session: an attacker landed in the shelLM LLM shell. -->
  <rule id="100311" level="6">
    <if_sid>100310</if_sid>
    <field name="event">^session_start$</field>
    <description>shelLM LLM SSH honeypot: new session from $(srcip).</description>
    <group>shellm,attack,ssh,</group>
  </rule>

  <!-- Phase C-2 adaptive persona: run.sh logs the tier persona.py published for
       this source IP (see src/soar/persona.py). Children of 100311, so they
       replace the generic session alert when the surface adapted. -->
  <rule id="100312" level="10">
    <if_sid>100311</if_sid>
    <field name="tier">^SKILLED$</field>
    <description>shelLM adaptive persona: SKILLED attacker $(srcip) served the rich decoy environment ($(persona)).</description>
    <group>shellm,engagement,tier_skilled,attack,</group>
  </rule>

  <rule id="100313" level="7">
    <if_sid>100311</if_sid>
    <field name="tier">^OPPORTUNIST$</field>
    <description>shelLM adaptive persona: OPPORTUNIST $(srcip) served the low-value box ($(persona)).</description>
    <group>shellm,engagement,tier_opportunist,attack,</group>
  </rule>


  <!-- Per-command visibility inside the LLM shell. LinuxSSHbot.py is patched at
       build time (services/shelLM/patch_command_log.py) to log one JSON line per
       command typed, with the session's srcip/tier/persona. The categories mirror
       the snoopy ones (100411-100415) so both honeypots read the same way.

       Deliberately NOT tagged "deep_attack": that group drives the SKILLED
       correlation rule (100401), which has no <same_source_ip/> and would then
       bleed across honeypots. shelLM commands stay in shellm_* groups; giving the
       LLM honeypot its own tier rule is a separate, deliberate step. -->
  <rule id="100314" level="3">
    <if_sid>100310</if_sid>
    <field name="event">^command$</field>
    <description>shelLM LLM SSH honeypot: command from $(srcip) - $(command)</description>
    <group>shellm,attack,ssh,</group>
  </rule>

  <!-- TRIPWIRE, LLM side. The SKILLED persona's environment contains the same
       bait engage.py plants on the static box, so reading it means the same
       thing: the attacker took it. Placed before the category rules so it wins.
       This is what gives the LLM honeypot a terminal state - it drives the ban
       (see the active-response block for 100322 in wazuh_manager.conf), so an
       engaged attacker is eventually cut off instead of held forever. -->
  <rule id="100322" level="13">
    <if_sid>100314</if_sid>
    <field name="command" type="pcre2">(?i)(/root/\.ssh/id_rsa|/root/backup_db\.sql|/root/credentials\.txt)</field>
    <description>TRIPWIRE (shelLM): attacker $(srcip) read a planted lure in the LLM shell - $(command)</description>
    <group>shellm,engagement,tripwire,attack,credential_access,</group>
  </rule>

  <rule id="100315" level="5">
    <if_sid>100314</if_sid>
    <field name="command" type="pcre2">(?i)\b(whoami|id|uname|hostname|netstat|ss|ifconfig|ip\s+a|ps\s|lscpu|cat\s+/etc/(passwd|issue|os-release))\b</field>
    <description>shelLM recon/discovery from $(srcip): $(command)</description>
    <group>shellm,attack,recon,discovery,hp_recon,</group>
  </rule>

  <rule id="100316" level="7">
    <if_sid>100314</if_sid>
    <field name="command" type="pcre2">(?i)(cat|less|more|head|tail)\s+.*(shadow|id_rsa|\.ssh|credentials|\.aws|\.env|backup.*\.sql)</field>
    <description>shelLM credential access from $(srcip): $(command)</description>
    <group>shellm,attack,credential_access,deep_attack,</group>
  </rule>

  <rule id="100317" level="7">
    <if_sid>100314</if_sid>
    <field name="command" type="pcre2">(?i)(?:^|[;&amp;|]\s*|\bsudo\s+)(wget|curl|scp|tftp|nc|ncat|socat)\b</field>
    <description>shelLM ingress/tool transfer from $(srcip): $(command)</description>
    <group>shellm,attack,command_control,deep_attack,</group>
  </rule>

  <rule id="100318" level="8">
    <if_sid>100314</if_sid>
    <field name="command" type="pcre2">(?i)(?:^|[;&amp;|]\s*|\bsudo\s+)(useradd|adduser|usermod|chpasswd|crontab|update-rc\.d)\b|authorized_keys|systemctl\s+enable</field>
    <description>shelLM persistence attempt from $(srcip): $(command)</description>
    <group>shellm,attack,persistence,deep_attack,</group>
  </rule>

  <rule id="100319" level="8">
    <if_sid>100314</if_sid>
    <field name="command" type="pcre2">(?i)(history\s+-c|shred|rm\s+-rf\s+/var/log|:\s*&gt;\s*/var/log|&gt;\s*/var/log/auth\.log|unset\s+HISTFILE)</field>
    <description>shelLM defense evasion (log/history wipe) from $(srcip): $(command)</description>
    <group>shellm,attack,defense_evasion,deep_attack,</group>
  </rule>


</group>

<!--
  Phase C1 — honeypot command classification (snoopy command-audit log).
  Each executed command is decoded (see local_decoder.xml) and sorted into a
  MITRE-ish sophistication category. These category rules are the raw signal the
  Phase C2 correlation rules escalate into attacker tiers. IDs: 100410-100419.
-->
<group name="honeypot,command,">

  <!-- Base: any command executed on the honeypot (decoded from snoopy). Low. -->
  <rule id="100410" level="2">
    <decoded_as>snoopy</decoded_as>
    <description>Honeypot: command executed - $(command)</description>
    <options>no_full_log</options>
  </rule>

  <!-- Attacker context: the command carries an SSH client IP (snoopy logs
       SSH_CLIENT, empty for local/system execs). EVERYTHING below hangs off this,
       because the honeypot's own housekeeping otherwise trips the tiers: a
       container running `update-rc.d dbus defaults` and
       `update-alternatives --install /bin/nc ...` scored persistence + ingress
       and raised SKILLED with no attacker present (and no srcip to act on).
       Real attacker commands - including paramiko's non-interactive exec - all
       carry SSH_CLIENT, so nothing is lost.

       Matched on the raw snoopy line (`cli=<ip>`), not on <field name="srcip">:
       srcip is a *static* field in Wazuh, so a <field> test on it fails rule
       loading with "Field 'srcip' is static". -->
  <rule id="100416" level="2">
    <if_sid>100410</if_sid>
    <match type="pcre2">cli=\d+\.\d+\.\d+\.\d+</match>
    <description>Honeypot: command executed by an SSH client - $(command)</description>
    <options>no_full_log</options>
  </rule>

  <!-- Phase C4 TRIPWIRE: a command references a planted lure (see engage.py).
       Checked before the generic category rules so it wins on a lure hit. This
       is the loudest signal in the lab - the attacker took the bait. -->
  <rule id="100402" level="13">
    <if_sid>100416</if_sid>
    <field name="command" type="pcre2">(?i)(/root/\.ssh/id_rsa|/root/backup_db\.sql|/root/credentials\.txt)</field>
    <description>TRIPWIRE: attacker accessed a planted lure - $(command)</description>
    <group>engagement,tripwire,attack,credential_access,</group>
  </rule>

  <!-- Recon / discovery: enumerating the host, users, network.
       Short tokens (id, ss, ps, ip) are anchored to COMMAND POSITION - start of
       line, after a ;/&/| separator, or after sudo. Unanchored, `\bid\b` matched
       any argument containing the word (e.g. a JSON blob with "id":"100401") and
       `\bnc\b` matched `update-alternatives --install /bin/nc`. -->
  <rule id="100411" level="5">
    <if_sid>100416</if_sid>
    <field name="command" type="pcre2">(?i)(?:^|[;&amp;|]\s*|\bsudo\s+)(whoami|id|uname|hostname|netstat|ss|ifconfig|ip\s+a|ps\b|lscpu|cat\s+/etc/(passwd|issue|os-release))\b</field>
    <description>Honeypot recon/discovery: $(command)</description>
    <group>attack,recon,discovery,hp_recon,</group>
  </rule>

  <!-- Credential access: reading secrets. -->
  <rule id="100412" level="7">
    <if_sid>100416</if_sid>
    <field name="command" type="pcre2">(?i)(cat|less|more|head|tail)\s+.*(shadow|id_rsa|\.ssh|credentials|\.aws|\.env|backup.*\.sql)</field>
    <description>Honeypot credential access: $(command)</description>
    <group>attack,credential_access,deep_attack,</group>
  </rule>

  <!-- Ingress tool transfer: pulling payloads onto the box. -->
  <rule id="100413" level="7">
    <if_sid>100416</if_sid>
    <field name="command" type="pcre2">(?i)(?:^|[;&amp;|]\s*|\bsudo\s+)(wget|curl|scp|tftp|nc|ncat|socat)\b</field>
    <description>Honeypot ingress/tool transfer: $(command)</description>
    <group>attack,command_control,deep_attack,</group>
  </rule>

  <!-- Persistence: backdoor accounts, cron, keys, services. -->
  <rule id="100414" level="8">
    <if_sid>100416</if_sid>
    <field name="command" type="pcre2">(?i)(?:^|[;&amp;|]\s*|\bsudo\s+)(useradd|adduser|usermod|chpasswd|crontab|update-rc\.d)\b|authorized_keys|systemctl\s+enable</field>
    <description>Honeypot persistence attempt: $(command)</description>
    <group>attack,persistence,deep_attack,</group>
  </rule>

  <!-- Defense evasion: wiping logs / history. -->
  <rule id="100415" level="8">
    <if_sid>100416</if_sid>
    <field name="command" type="pcre2">(?i)(history\s+-c|shred|rm\s+-rf\s+/var/log|:\s*>\s*/var/log|&gt;\s*/var/log/auth\.log|unset\s+HISTFILE)</field>
    <description>Honeypot defense evasion (log/history wipe): $(command)</description>
    <group>attack,defense_evasion,deep_attack,</group>
  </rule>

</group>

<!--
  Phase C2 — attacker sophistication tiers (native Wazuh correlation).
  Fold the per-command category hits into tiers by frequency within a window.

  ONE tier vocabulary for every honeypot. Each surface tags its category rules
  with the shared groups - "hp_recon" for enumeration, "deep_attack" for anything
  beyond it - and these two rules do the escalating. Adding a honeypot means
  tagging its rules, not copying a tier pair.

  Correlated with <same_source_ip/>, which the original C2 notes said was
  impossible: snoopy events carry no srcip at exec level. They do now - the
  honeypot logs SSH_CLIENT (Phase C5) and rule 100416 drops anything without it -
  and shelLM's per-command feed carries the session IP. So the tiers key on the
  attacker, not on "there is only ever one of them in the lab", and evidence from
  BOTH honeypots adds up for the same source: recon on the static box plus
  credential access in the LLM shell is one escalating attacker, which is exactly
  right.

  Tier rules sit in their own "engagement" group so they never count themselves.
  IDs: 100400-100409.
-->
<group name="engagement,">

  <!-- OPPORTUNIST: repeated host/network recon (enumeration), nothing deeper. -->
  <rule id="100400" level="8" frequency="3" timeframe="120">
    <if_matched_group>hp_recon</if_matched_group>
    <same_source_ip/>
    <description>Attacker tier OPPORTUNIST: repeated recon from $(srcip).</description>
    <group>engagement,tier_opportunist,</group>
  </rule>

  <!-- SKILLED: 2+ beyond-recon actions (cred access / ingress / persistence /
       evasion) within the window. This is the ENGAGE trigger: Active Response
       plants lures + holds the ban (see Phase C3). -->
  <rule id="100401" level="12" frequency="2" timeframe="120">
    <if_matched_group>deep_attack</if_matched_group>
    <same_source_ip/>
    <description>Attacker tier SKILLED: multiple beyond-recon actions from $(srcip) - engage.</description>
    <group>engagement,tier_skilled,</group>
  </rule>

</group>
